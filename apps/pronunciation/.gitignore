# ─────────────────────────────────────────────
#  発音アプリ固有の .gitignore
#  共通パターン（秘密情報・node_modules・.venv・__pycache__・OS/エディタ等）は
#  リポジトリ直下の /.gitignore が全階層に効くので、ここには書かない。
# ─────────────────────────────────────────────

# --- ビルドツール・実装計画（＝「作り方」が分かるもの） ---
tools/
docs/plans/

# 必ずコミットするもの（保険：mp3 を一括除外するルールを誰かが足しても守る）
#   data/audio/**/*.mp3 と data/text.json はオフライン再生の必須データ。
!data/audio/
!data/audio/**
