# ─────────────────────────────────────────────
#  単語アプリ固有の .gitignore
#  共通パターン（秘密情報・node_modules・.venv・__pycache__・ログ・OS/エディタ等）は
#  リポジトリ直下の /.gitignore が全階層に効くので、ここには書かない。
#  方針: 成果物（words.json・音声mp3）とソース/スクリプトは追跡。
#        第三者素材・中間生成物のみここで無視する。
# ─────────────────────────────────────────────

# --- ダウンロードした第三者素材（再取得可・再配布しない） ---
# Goethe 公式 PDF。取得は tools 内の curl コマンドで再現できる。
tools/sources/

# --- ビルド時の中間生成物（再生成可。data/<level>/words.json が正本） ---
tools/batches/
tools/batches_a2/
data/A1/parts/
data/A2/parts/

# ─────────────────────────────────────────────
# 意図的に「追跡する」もの（無視しない）:
#   data/A1, data/A2 の words.json と audio/*.mp3・audio/lemma/*.mp3
#     … アプリの成果物。オフライン再生に必須なのでコミットする（生成は edge-tts でネットワーク必須・高コスト）。
#   index.html, css/, js/, docs/, tests/, README.md, CLAUDE.md, package.json
#   tools/*.py, tools/*.mjs, tools/*.cjs, tools/sentence_pipeline.md, tools/a1_seed.json, tools/a2_seed.json
# 注: tools/.venv（約157MB, edge-tts用）は root の .venv/ で無視済み。
#     再構築: python3 -m venv tools/.venv && tools/.venv/bin/pip install edge-tts
# ─────────────────────────────────────────────

# --- 語彙構築の中間生成物（正本は data/<level>/words.json と tools/raw/<level>.jsonl） ---
# gloss 作業のバッチ入出力（マージ済み → tools/raw/a1.jsonl）
tools/raw/gloss/
tools/raw/a1_review.json
# 高頻度コア語の補完バッチ（マージ済み → tools/raw/a1.jsonl）
tools/raw/supp/
# 例文生成のバッチ入出力（マージ済み → data/A1/words.json）
tools/raw/exgen/
# 冠詞 de/het 検証パスの入出力（修正は適用済み・内容は changes-log に記録）
tools/raw/verify/
# 公式 PDF のパース結果（tools/parse_numo.mjs / parse_freq.mjs で再生成できる）
tools/raw/nt2_freq_parsed.json
tools/raw/nt2_freq_missing.json
tools/raw/numo_a1a2_new.json
